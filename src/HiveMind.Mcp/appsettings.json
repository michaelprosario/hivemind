{
  "Mcp": {
    "Transport": "stdio",
    "HttpPath": "/mcp"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "VectorSearch": {
    "AllowedSourceRoot": "../HiveMind.Web/data/files",
    "MaxSourceFileSizeBytes": 10485760,
    "SupportedExtensions": [ ".txt", ".md", ".json", ".csv", ".log", ".cs" ],
    "MaxFilesPerDirectoryIngest": 500,
    "ChunkSizeCharacters": 1600,
    "ChunkOverlapCharacters": 240,
    "EmbeddingBatchSize": 32,
    "ModelDirectory": "../HiveMind.Web/models/bge-small-en-v1.5-onnx/onnx",
    "ModelRevision": "BAAI/bge-small-en-v1.5",
    "CatalogPath": "../HiveMind.Web/data/vector-search/catalog.json",
    "QdrantEndpoint": "http://localhost:6333",
    "QdrantApiKey": "local-development-secret"
  }
}
