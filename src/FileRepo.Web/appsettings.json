{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileRepository": { "RootPath": "./data/files", "MaxFileSizeBytes": 10485760 },
  "VectorSearch": {
    "AllowedSourceRoot": "./data/files",
    "MaxSourceFileSizeBytes": 10485760,
    "SupportedExtensions": [ ".txt", ".md", ".json", ".csv", ".log", ".cs" ],
    "ChunkSizeCharacters": 1600,
    "ChunkOverlapCharacters": 240,
    "EmbeddingBatchSize": 32,
    "ModelDirectory": "./data/models/bge-small-en-v1.5",
    "ModelRevision": "BAAI/bge-small-en-v1.5",
    "CatalogPath": "./data/vector-search/catalog.json",
    "QdrantEndpoint": "http://localhost:6333",
    "QdrantApiKey": ""
  },
  "Swagger": { "Enabled": true }
}
